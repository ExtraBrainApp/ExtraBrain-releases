---
import MarketingLayout from './MarketingLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BacklinksFooter from '../components/BacklinksFooter.astro';
import { organizationSchema, softwareApplicationSchema, websiteSchema, faqSchema } from '../data/product';

interface Props {
  title: string;
  description: string;
  h1: string;
  lead: string;
  eyebrow?: string;
  faq?: Array<{ question: string; answer: string }>;
}

const { title, description, h1, lead, eyebrow = 'Free interview tool', faq = [] } = Astro.props;

const schemaGraph = [
  organizationSchema(),
  websiteSchema(),
  softwareApplicationSchema(description),
  ...(faq.length ? [faqSchema(faq)] : []),
];
---

<MarketingLayout title={title} description={description} schemaGraph={schemaGraph}>
  <SiteHeader />
  <main id="top" class="tool-main">
    <section class="container tool-hero">
      <span class="tool-eyebrow">{eyebrow}</span>
      <h1 class="tool-h1">{h1}</h1>
      <p class="tool-lead">{lead}</p>
    </section>

    <section class="container tool-body">
      <slot />
    </section>

    {faq.length > 0 && (
      <section class="container tool-faq">
        <h2>Frequently asked questions</h2>
        <div class="tool-faq-list">
          {faq.map((item) => (
            <details class="tool-faq-item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <section class="container tool-cta">
      <div class="tool-cta-card">
        <h2>Prepare with ExtraBrain</h2>
        <p>ExtraBrain is a free, local-first Mac AI interview assistant and meeting copilot with live transcription, screen-aware context, and privacy controls. Use it to rehearse, follow live context where allowed, and review every session.</p>
        <div class="tool-cta-actions">
          <a class="btn primary" href="/download/#install">Download Free</a>
          <a class="btn ghost" href="/tools/">All free tools</a>
        </div>
      </div>
    </section>
  </main>
  <BacklinksFooter />
</MarketingLayout>

<style is:global>
  .tool-main { padding-bottom: 64px; }
  .tool-hero { padding: 40px 0 8px; }
  .tool-eyebrow {
    display: inline-flex; align-items: center; padding: 6px 11px; border-radius: 10px;
    background: rgba(255, 255, 255, 0.58); border: 1px solid rgba(16, 24, 40, 0.1);
    color: var(--text-secondary); font-family: var(--font-mono); font-size: 11px;
    font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase;
  }
  .tool-h1 {
    max-width: 760px; margin: 16px 0 14px; color: var(--ink); font-family: var(--font-serif);
    font-size: clamp(36px, 4.6vw, 60px); font-weight: 400; line-height: 1.04; letter-spacing: 0;
  }
  .tool-lead { max-width: 680px; color: var(--text-secondary); font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; }
  .tool-body { margin-top: 28px; }

  .tool-card {
    background: rgba(255, 255, 255, 0.7); border: 1px solid rgba(16, 24, 40, 0.1);
    border-radius: 20px; padding: clamp(20px, 3vw, 32px); box-shadow: var(--shadow-editorial-soft);
  }
  .tool-grid { display: grid; gap: 18px; }
  @media (min-width: 720px) { .tool-grid.cols-2 { grid-template-columns: 1fr 1fr; } }
  .tool-field { display: flex; flex-direction: column; gap: 6px; }
  .tool-field label { font-size: 13px; font-weight: 600; color: var(--text-secondary); }
  .tool-field input, .tool-field select, .tool-field textarea {
    width: 100%; padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(16, 24, 40, 0.16);
    background: #fff; color: var(--ink); font-family: var(--font-sans); font-size: 15px;
  }
  .tool-field textarea { min-height: 160px; resize: vertical; line-height: 1.5; }
  .tool-field input:focus, .tool-field select:focus, .tool-field textarea:focus {
    outline: none; border-color: var(--editorial-purple); box-shadow: 0 0 0 3px rgba(141, 104, 255, 0.18);
  }
  .tool-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .tool-result {
    margin-top: 22px; padding: 20px; border-radius: 16px; background: var(--editorial-canvas-alt);
    border: 1px solid rgba(16, 24, 40, 0.08);
  }
  .tool-result h3 { margin: 0 0 10px; font-size: 15px; color: var(--text-secondary); font-weight: 600; }
  .tool-metric { font-family: var(--font-serif); font-size: clamp(30px, 4vw, 44px); color: var(--editorial-purple-deep); line-height: 1.1; }
  .tool-note { margin-top: 8px; color: var(--text-subtle); font-size: 14px; }
  .tool-pill-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .tool-pill { padding: 6px 12px; border-radius: 999px; font-size: 13px; font-weight: 600; }
  .tool-pill.match { background: rgba(101, 215, 199, 0.28); color: #0d5c50; }
  .tool-pill.missing { background: rgba(255, 141, 141, 0.22); color: #8a2b2b; }

  .tool-faq { margin-top: 56px; }
  .tool-faq h2 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(26px, 3vw, 36px); margin-bottom: 18px; }
  .tool-faq-list { display: grid; gap: 10px; max-width: 820px; }
  .tool-faq-item { background: rgba(255, 255, 255, 0.6); border: 1px solid rgba(16, 24, 40, 0.1); border-radius: 14px; padding: 14px 18px; }
  .tool-faq-item summary { cursor: pointer; font-weight: 600; color: var(--ink); }
  .tool-faq-item p { margin: 10px 0 0; }

  .tool-cta { margin-top: 56px; }
  .tool-cta-card { background: var(--gradient-editorial); color: #fff; border-radius: 24px; padding: clamp(24px, 4vw, 44px); box-shadow: var(--shadow-editorial-glow); }
  .tool-cta-card h2 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(26px, 3vw, 38px); margin: 0 0 12px; }
  .tool-cta-card p { color: rgba(255, 255, 255, 0.9); max-width: 640px; }
  .tool-cta-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
  .tool-cta-actions .btn.primary { background: #fff; color: var(--editorial-purple-deep); box-shadow: none; }
  .tool-cta-actions .btn.ghost { color: #fff; border-color: rgba(255, 255, 255, 0.5); background: rgba(255, 255, 255, 0.08); }
</style>
