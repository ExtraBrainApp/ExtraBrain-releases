---
import { contactEmail } from '../data/product';

type Props = {
  isHome?: boolean;
  brandHref?: string;
  downloadHref?: string;
  downloadLabel?: string;
  downloadDataAttr?: string;
  mobileDownloadDataAttr?: string;
  downloadTrackEvent?: string;
  feedbackHref?: string;
  feedbackTrigger?: boolean;
};

const {
  isHome = false,
  brandHref = isHome ? '#top' : '/',
  downloadHref = '/download/#install',
  downloadLabel = 'Download Free',
  downloadDataAttr = 'download-cta-nav',
  mobileDownloadDataAttr = 'download-cta-nav-mobile',
  downloadTrackEvent = 'download_nav_clicked',
  feedbackHref = `mailto:${contactEmail}?subject=ExtraBrain%20Feedback`,
  feedbackTrigger = false,
} = Astro.props;

const productHref = isHome ? '#overview' : '/#overview';
const useCasesHref = isHome ? '#workflows' : '/#workflows';
const downloadAttributes = {
  'data-track': downloadTrackEvent,
};
---

<header class="site-header">
  <div class="container nav">
    <a href={brandHref} class="brand" aria-label="ExtraBrain home">
      <img class="brand-icon" src="/assets/images/logo-192.png" alt="ExtraBrain logo" width="34" height="34" />
      <span class="brand-wordmark brand-wordmark--nav" aria-hidden="true">
        <span class="brand-extra">Extra</span><span class="brand-brain">Brain</span>
      </span>
    </a>
    <nav class="nav-links" aria-label="Primary navigation">
      <a href={productHref}>Product</a>
      <a href={useCasesHref}>Use cases</a>
      <a href="/download/#install">Download</a>
      <a href="/pricing/">Pricing</a>
      <a href="/privacy/">Privacy</a>
      <a href="/blog/">Blog</a>
      <a href="/interview-questions/">Interview Questions</a>
      <a href="/help/">Help</a>
      <a href={feedbackHref} data-feedback-trigger={feedbackTrigger ? '' : undefined}>Feedback</a>
    </nav>
    <div class="nav-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false">
        <span class="theme-toggle-icon" aria-hidden="true"></span>
      </button>
      <a class="btn primary" href={downloadHref} data-attr={downloadDataAttr} {...downloadAttributes}>{downloadLabel}</a>
    </div>
    <div class="mobile-nav-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false">
        <span class="theme-toggle-icon" aria-hidden="true"></span>
      </button>
      <a class="btn primary mobile-only" href={downloadHref} data-attr={mobileDownloadDataAttr} {...downloadAttributes}>{downloadLabel}</a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var storageKey = 'extrabrain-theme';
    var root = document.documentElement;
    var controls = document.querySelectorAll('[data-theme-toggle]');

    function getTheme() {
      return root.dataset.theme === 'dark' ? 'dark' : 'light';
    }

    function syncControls() {
      var isDark = getTheme() === 'dark';
      controls.forEach(function (control) {
        control.setAttribute('aria-pressed', String(isDark));
        control.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
      });
    }

    function setTheme(theme) {
      root.dataset.theme = theme;
      try {
        localStorage.setItem(storageKey, theme);
        localStorage.setItem('starlight-theme', theme);
      } catch (_) {}
      syncControls();
    }

    controls.forEach(function (control) {
      control.addEventListener('click', function () {
        setTheme(getTheme() === 'dark' ? 'light' : 'dark');
      });
    });

    syncControls();
  })();
</script>
