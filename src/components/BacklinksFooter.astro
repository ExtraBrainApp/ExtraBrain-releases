  }

  .backlinks-badges img {
    height: 50px;
    width: auto;
    object-fit: contain;
  }

  .backlinks-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
  }

  .backlinks-text .backlinks-row {
