    color: rgba(255, 255, 255, 0.45);
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .backlinks-text a:hover {
    color: rgba(255, 255, 255, 0.75);
    transform: scale(1.05);
  }
</style>
