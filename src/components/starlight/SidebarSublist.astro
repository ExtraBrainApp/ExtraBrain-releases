---
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';
import { Badge, Icon } from '@astrojs/starlight/components';
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import type { StarlightIcon } from '@astrojs/starlight/types';

type SidebarEntry = StarlightRouteData['sidebar'][number];

interface Props {
  sublist: SidebarEntry[];
  nested?: boolean;
}

const { sublist, nested } = Astro.props;

const groupIcons: Record<string, StarlightIcon> = {
  'Start Here': 'open-book',
  Providers: 'cloud-download',
  'Using ExtraBrain': 'laptop',
  'Privacy And Settings': 'setting',
  'Billing And Support': 'star',
};

const linkIconRules: Array<[RegExp, StarlightIcon]> = [
  [/\/help\/?$/, 'open-book'],
  [/what-is-extrabrain/, 'information'],
  [/first-run-setup/, 'rocket'],
  [/macos-permissions/, 'approve-check-circle'],
  [/installation/, 'download'],
  [/transcription|deepgram|provider|anthropic|openai|codex|custom-openai/, 'cloud-download'],
  [/start-recording/, 'rocket'],
  [/screenshots|webcam/, 'laptop'],
  [/follow-up|send-feedback/, 'comment-alt'],
  [/detected-topics|keyboard-shortcuts/, 'list-format'],
  [/interviews/, 'comment'],
  [/privacy|handles-data/, 'approve-check-circle'],
  [/settings\/?$/, 'setting'],
  [/profiles|billing|license|free-vs-pro/, 'star'],
  [/ui-appearance/, 'sun'],
  [/audio|transcript-cleanup|voice-trigger|screenshot-settings|automatic-updates/, 'setting'],
  [/sessions-history/, 'document'],
  [/troubleshooting/, 'warning'],
];

const hasCurrentEntry = (entries: SidebarEntry[]): boolean =>
  entries.some((entry) => (entry.type === 'link' ? entry.isCurrent : hasCurrentEntry(entry.entries)));

const getGroupIcon = (label: string): StarlightIcon => groupIcons[label] ?? 'open-book';
const getLinkIcon = (href: string): StarlightIcon =>
  linkIconRules.find(([pattern]) => pattern.test(href))?.[1] ?? 'document';
---

<ul class:list={{ 'top-level': !nested }}>
  {
    sublist.map((entry) => (
      <li>
        {entry.type === 'link' ? (
          <a
            href={entry.href}
            aria-current={entry.isCurrent ? 'page' : undefined}
            class:list={['help-sidebar-link', { large: !nested }, entry.attrs.class]}
            {...entry.attrs}
          >
            <Icon
              name={getLinkIcon(entry.href)}
              class="help-sidebar-icon"
              size={nested ? '0.875rem' : '0.95rem'}
            />
            <span>{entry.label}</span>
            {entry.badge && (
              <Badge
                variant={entry.badge.variant}
                class={entry.badge.class}
                text={entry.badge.text}
              />
            )}
          </a>
        ) : (
          <details open={hasCurrentEntry(entry.entries) || !entry.collapsed}>
            <summary>
              <span class="group-label">
                <Icon name={getGroupIcon(entry.label)} class="help-sidebar-icon" size="0.95rem" />
                <span class="large">{entry.label}</span>
                {entry.badge && (
                  <Badge
                    variant={entry.badge.variant}
                    class={entry.badge.class}
                    text={entry.badge.text}
                  />
                )}
              </span>
              <Icon name="right-caret" class="caret" size="1.15rem" />
            </summary>
            <SidebarRestorePoint />
            <Astro.self sublist={entry.entries} nested />
          </details>
        )}
      </li>
    ))
  }
</ul>

<style>
  @layer starlight.core {
    ul {
      --sl-sidebar-item-padding-inline: 0.45rem;
      list-style: none;
      padding: 0;
    }

    li {
      overflow-wrap: anywhere;
    }

    ul ul li {
      margin-inline-start: 0.75rem;
      border-inline-start: 1px solid var(--sl-color-hairline-light);
      padding-inline-start: 0.4rem;
    }

    .top-level > li + li {
      margin-top: 0.55rem;
    }

    summary,
    a {
      border-radius: 0.35rem;
      line-height: 1.3;
    }

    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.2rem var(--sl-sidebar-item-padding-inline);
      cursor: pointer;
      user-select: none;
    }

    summary::marker,
    summary::-webkit-details-marker {
      display: none;
    }

    .group-label,
    .help-sidebar-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      min-width: 0;
    }

    .group-label {
      color: var(--sl-color-white);
      font-weight: 650;
    }

    .large {
      font-size: var(--sl-text-sm);
      font-weight: 650;
      color: inherit;
    }

    .help-sidebar-icon {
      flex: 0 0 auto;
      color: var(--sl-color-gray-3);
      opacity: 0.85;
    }

    .caret {
      flex-shrink: 0;
      color: var(--sl-color-gray-3);
      transition: transform 0.2s ease-in-out;
    }

    :global([dir='rtl']) .caret {
      transform: rotateZ(180deg);
    }

    [open] > summary .caret {
      transform: rotateZ(90deg);
    }

    a {
      color: var(--sl-color-gray-2);
      padding: 0.32rem var(--sl-sidebar-item-padding-inline);
      text-decoration: none;
    }

    a > span,
    .group-label > span {
      min-width: 0;
    }

    a:hover,
    a:focus {
      color: var(--sl-color-white);
    }

    a:hover .help-sidebar-icon,
    a:focus .help-sidebar-icon,
    summary:hover .help-sidebar-icon {
      color: var(--sl-color-accent-high);
      opacity: 1;
    }

    [aria-current='page'],
    [aria-current='page']:hover,
    [aria-current='page']:focus {
      color: var(--sl-color-text-invert);
      background-color: var(--sl-color-text-accent);
      font-weight: 650;
    }

    [aria-current='page'] .help-sidebar-icon {
      color: currentColor;
      opacity: 0.9;
    }

    a > *:not(:last-child),
    .group-label > *:not(:last-child) {
      margin-inline-end: 0;
    }

    @media (min-width: 50rem) {
      .top-level > li + li {
        margin-top: 0.45rem;
      }

      a {
        font-size: 0.8125rem;
      }
    }
  }
</style>
