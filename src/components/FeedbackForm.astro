---
---

<dialog class="feedback-dialog" id="feedback-dialog">
  <form class="feedback-form" id="feedback-form" method="dialog">
    <div class="feedback-header">
      <h2 class="feedback-title">Send feedback</h2>
      <button type="button" class="feedback-close" id="feedback-close" aria-label="Close feedback form">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M4.5 4.5L13.5 13.5M13.5 4.5L4.5 13.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <p class="feedback-description">We'd love to hear from you. Share a suggestion, report an issue, or just say hi.</p>
    <label class="feedback-label" for="feedback-message">Message</label>
    <textarea
      class="feedback-textarea"
      id="feedback-message"
      name="message"
      rows="4"
      required
      placeholder="What's on your mind?"
    ></textarea>
    <label class="feedback-label" for="feedback-email">Email <span class="feedback-optional">(optional)</span></label>
    <input
      class="feedback-input"
      id="feedback-email"
      name="email"
      type="email"
      placeholder="you@example.com"
      autocomplete="email"
    />
    <div class="feedback-actions">
      <button type="submit" class="btn primary feedback-submit">Send feedback</button>
    </div>
    <div class="feedback-success" id="feedback-success" hidden>
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <circle cx="14" cy="14" r="13" stroke="var(--signal-mint, #65d7c7)" stroke-width="2"/>
        <path d="M9 14.5L12.5 18L19 11" stroke="var(--signal-mint, #65d7c7)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <p>Thank you for your feedback!</p>
    </div>
  </form>
</dialog>

<script is:inline>
(function () {
  var dialog = document.getElementById('feedback-dialog');
  var form = document.getElementById('feedback-form');
  var closeBtn = document.getElementById('feedback-close');
  var successEl = document.getElementById('feedback-success');
  if (!dialog || !form) return;

  function captureEvent(name, props) {
    if (window.posthog && typeof window.posthog.capture === 'function') {
      window.posthog.capture(name, props || {});
    }
  }

  document.querySelectorAll('[data-feedback-trigger]').forEach(function (trigger) {
    trigger.addEventListener('click', function (e) {
      e.preventDefault();
      dialog.showModal();
      captureEvent('website_feedback_opened', { page: window.location.pathname });
    });
  });

  closeBtn.addEventListener('click', function () {
    dialog.close();
  });

  dialog.addEventListener('click', function (e) {
    if (e.target === dialog) dialog.close();
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var message = form.querySelector('#feedback-message').value.trim();
    var email = form.querySelector('#feedback-email').value.trim();
    if (!message) return;

    captureEvent('website_feedback_submitted', {
      message: message,
      email: email || null,
      page: window.location.pathname
    });

    form.querySelector('.feedback-header').hidden = true;
    form.querySelector('.feedback-description').hidden = true;
    form.querySelectorAll('.feedback-label, .feedback-textarea, .feedback-input, .feedback-actions').forEach(function (el) {
      el.hidden = true;
    });
    successEl.hidden = false;

    setTimeout(function () {
      dialog.close();
      form.reset();
      form.querySelector('.feedback-header').hidden = false;
      form.querySelector('.feedback-description').hidden = false;
      form.querySelectorAll('.feedback-label, .feedback-textarea, .feedback-input, .feedback-actions').forEach(function (el) {
        el.hidden = false;
      });
      successEl.hidden = true;
    }, 2000);
  });
})();
</script>

<style>
  .feedback-dialog {
    position: fixed;
    margin: auto;
    padding: 0;
    border: 1px solid rgba(16, 24, 40, 0.1);
    border-radius: 24px;
    background: rgba(255, 249, 240, 0.96);
    box-shadow:
      0 24px 64px rgba(16, 24, 40, 0.14),
      0 0 0 1px rgba(141, 104, 255, 0.08);
    backdrop-filter: blur(20px);
    max-width: 480px;
    width: calc(100vw - 32px);
    color: var(--ink, #121821);
  }

  .feedback-dialog::backdrop {
    background: rgba(18, 24, 33, 0.42);
    backdrop-filter: blur(4px);
  }

  .feedback-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
  }

  .feedback-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .feedback-title {
    margin: 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 18px;
    font-weight: 700;
    color: var(--ink, #121821);
  }

  .feedback-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: none;
    background: rgba(16, 24, 40, 0.06);
    color: var(--text-secondary, #495461);
    cursor: pointer;
    transition: background 160ms ease;
  }

  .feedback-close:hover {
    background: rgba(16, 24, 40, 0.12);
  }

  .feedback-description {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-secondary, #495461);
  }

  .feedback-label {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink, #121821);
    margin-top: 4px;
  }

  .feedback-optional {
    font-weight: 400;
    color: var(--text-subtle, #5f6a75);
  }

  .feedback-textarea,
  .feedback-input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid rgba(16, 24, 40, 0.12);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.72);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink, #121821);
    resize: vertical;
    transition: border-color 160ms ease;
  }

  .feedback-textarea:focus,
  .feedback-input:focus {
    outline: none;
    border-color: var(--editorial-purple, #8d68ff);
    box-shadow: 0 0 0 3px rgba(141, 104, 255, 0.12);
  }

  .feedback-textarea::placeholder,
  .feedback-input::placeholder {
    color: var(--text-subtle, #5f6a75);
    opacity: 0.7;
  }

  .feedback-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 4px;
  }

  .feedback-submit {
    min-height: 44px;
    padding: 0 20px;
    font-size: 14px;
  }

  .feedback-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 24px 0;
    text-align: center;
  }

  .feedback-success p {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink, #121821);
  }

  @media (max-width: 560px) {
    .feedback-form {
      padding: 22px;
    }

    .feedback-dialog {
      border-radius: 20px;
    }
  }
</style>
