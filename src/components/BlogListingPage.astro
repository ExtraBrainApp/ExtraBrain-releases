---
import type { CollectionEntry } from 'astro:content';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import BacklinksFooter from './BacklinksFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { productCategory, githubUrl } from '../data/product';

type ListingPost = CollectionEntry<'blog'> | CollectionEntry<'interviewQuestions'>;

type Props = {
  posts: ListingPost[];
  currentPage: number;
  totalPages: number;
  basePath?: string;
  baseTitle?: string;
  titleSuffix?: string;
  description?: string;
  eyebrow?: string;
  heading?: string;
  lead?: string;
  breadcrumbLabel?: string;
  topics?: string[];
  schemaType?: 'Blog' | 'CollectionPage';
  itemSchemaType?: 'BlogPosting' | 'Article';
  readLabel?: string;
  paginationLabel?: string;
};

const {
  posts,
  currentPage,
  totalPages,
  basePath = '/blog/',
  baseTitle = 'ExtraBrain Blog',
  titleSuffix = 'AI Interview Prep',
  description = 'Read ExtraBrain articles about AI interview prep, system design, productivity, responsible AI, and local-first meeting workflows.',
  eyebrow = 'ExtraBrain Blog',
  heading = 'AI interview prep, system design, and responsible productivity.',
  lead = 'Field notes, experiments, and practical guides for using AI thoughtfully in interviews, meetings, and technical work.',
  breadcrumbLabel = 'Blog',
  topics = ['System design and interview prep', 'Responsible AI workflows', 'Local-first productivity'],
  schemaType = 'Blog',
  itemSchemaType = 'BlogPosting',
  readLabel = 'Read article',
  paginationLabel = 'Blog pages',
} = Astro.props;
const feedbackHref = 'mailto:info@extrabrain.app?subject=ExtraBrain%20Feedback';
const title = currentPage === 1 ? `${baseTitle} - ${titleSuffix}` : `${baseTitle} - Page ${currentPage}`;
const siteUrl = Astro.site ?? new URL('https://extrabrain.app');
const listingUrl = new URL(currentPage === 1 ? basePath : `${basePath}page/${currentPage}/`, siteUrl).href;
const paginationPages = Array.from({ length: totalPages }, (_, index) => index + 1);
const pageHref = (page: number) => (page === 1 ? basePath : `${basePath}page/${page}/`);
const postHref = (post: ListingPost) => `${basePath}${post.id}/`;
const imagePath = (post: ListingPost) => post.data.ogImage?.trim() || undefined;
const coverImageAlt = (post: ListingPost) =>
  post.data.ogImageAlt?.trim() || `${post.data.title} article cover image for ExtraBrain AI interview prep`;
const prevUrl = currentPage > 1 ? pageHref(currentPage - 1) : undefined;
const nextUrl = currentPage < totalPages ? pageHref(currentPage + 1) : undefined;
const schemaGraph = [
  {
    '@type': schemaType,
    name: currentPage === 1 ? baseTitle : `${baseTitle} - Page ${currentPage}`,
    description,
    url: listingUrl,
    publisher: {
      '@type': 'Organization',
      name: 'ExtraBrain',
      url: new URL('/', siteUrl).href,
      logo: new URL('/assets/images/logo-512.png', siteUrl).href,
    },
    blogPost: posts.map((post) => ({
      '@type': itemSchemaType,
      headline: post.data.seoTitle ?? post.data.title,
      description: post.data.description,
      url: new URL(postHref(post), siteUrl).href,
      datePublished: post.data.publishDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
      author: { '@type': 'Organization', name: post.data.author },
      image: new URL(imagePath(post) ?? '/assets/images/logo-512.png', siteUrl).href,
    })),
  },
];
---

<MarketingLayout title={title} description={description} prevUrl={prevUrl} nextUrl={nextUrl} schemaGraph={schemaGraph}>
  <SiteHeader feedbackHref={feedbackHref} />

  <main id="top" class="page-main blog-main">
    <section class="page-hero blog-hero">
      <div class="container page-hero-grid">
        <div>
          <nav class="breadcrumb-nav" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              <li><span>{breadcrumbLabel}</span></li>
            </ol>
          </nav>
          <p class="eyebrow">{eyebrow}</p>
          <h1>{heading}</h1>
          <p class="lead">{lead}</p>
        </div>
        <aside class="page-fact-panel" aria-label={`${breadcrumbLabel} topics`}>
          <span class="panel-label">Topics</span>
          <ul>
            {topics.map((topic) => <li>{topic}</li>)}
          </ul>
        </aside>
      </div>
    </section>

    <section class="light-section page-content-section blog-list-section">
      <div class="container">
        <div class="blog-list">
          {posts.map((post) => (
            <article class="blog-card">
              {imagePath(post) && (
                <a class="blog-card-cover-link" href={postHref(post)} aria-label={`Read ${post.data.title}`}>
                  <img class="blog-card-cover" src={imagePath(post)} alt={coverImageAlt(post)} loading="lazy" />
                </a>
              )}
              <div class="blog-card-body">
                <div class="blog-card-meta">
                  <time datetime={post.data.publishDate.toISOString()}>
                    {post.data.publishDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                  </time>
                  {post.data.tags.length > 0 && <span>{post.data.tags.slice(0, 2).join(' · ')}</span>}
                </div>
                <h2><a href={postHref(post)}>{post.data.title}</a></h2>
                <p>{post.data.description}</p>
                <a class="blog-read-link" href={postHref(post)}>{readLabel}<span aria-hidden="true"> →</span></a>
              </div>
            </article>
          ))}
        </div>

        {totalPages > 1 && (
          <nav class="blog-pagination" aria-label={paginationLabel}>
            {currentPage > 1 ? (
              <a class="blog-pagination-link blog-pagination-link--wide" href={pageHref(currentPage - 1)}>← Previous</a>
            ) : (
              <span class="blog-pagination-link blog-pagination-link--wide is-disabled" aria-disabled="true">← Previous</span>
            )}
            <div class="blog-pagination-pages">
              {paginationPages.map((page) => (
                page === currentPage ? (
                  <span class="blog-pagination-link is-current" aria-current="page">{page}</span>
                ) : (
                  <a class="blog-pagination-link" href={pageHref(page)}>{page}</a>
                )
              ))}
            </div>
            {currentPage < totalPages ? (
              <a class="blog-pagination-link blog-pagination-link--wide" href={pageHref(currentPage + 1)}>Next →</a>
            ) : (
              <span class="blog-pagination-link blog-pagination-link--wide is-disabled" aria-disabled="true">Next →</span>
            )}
          </nav>
        )}
      </div>
    </section>
  </main>

  <footer>
    <div class="container footer-grid">
      <div>
        <a href="/" class="brand footer-brand">
          <img class="brand-icon" src="/assets/images/logo-192.png" alt="ExtraBrain logo" width="36" height="36" />
          <span class="brand-wordmark brand-wordmark--nav" aria-hidden="true">
            <span class="brand-extra">Extra</span><span class="brand-brain">Brain</span>
          </span>
        </a>
        <p>{productCategory}. Available for Mac today, with Windows and Linux planned.</p>
      </div>
      <div>
        <h2 class="footer-heading">Product</h2>
        <a href="/download/">Download</a>
        <a href="/pricing/">Pricing</a>
        <a href="/pricing/free-vs-pro/">Free vs Pro</a>
        <a href="/features/local-transcription/">Local transcription</a>
        <a href="/features/bring-your-own-provider/">BYO providers</a>
        <a href="/about/">About</a>
      </div>
      <div>
        <h2 class="footer-heading">Trust</h2>
        <a href="/privacy/">Privacy</a>
        <a href="/data-flow/">Data flow</a>
        <a href="/security/">Security</a>
        <a href="/responsible-use/">Responsible use</a>
      </div>
      <div>
        <h2 class="footer-heading">Use cases</h2>
        <a href="/use-cases/coding-interviews/">Coding interviews</a>
        <a href="/use-cases/system-design-interviews/">System design</a>
        <a href="/use-cases/behavioral-interviews/">Behavioral interviews</a>
        <a href="/use-cases/meetings/">Meetings</a>
        <a href="/platforms/zoom/">Zoom</a>
        <a href="/platforms/google-meet/">Google Meet</a>
        <a href="/platforms/coderpad/">CoderPad</a>
        <a href="/interview-guides/google/">Google interviews</a>
        <a href="/interview-guides/meta/">Meta interviews</a>
      </div>
      <div>
        <h2 class="footer-heading">Support</h2>
        <a href="/help/">Help center</a>
        <a href="/providers/">Providers</a>
        <a href="/compare/cluely/">Compare Cluely</a>
        <a href="/compare/interviewcoder/">Compare InterviewCoder</a>
        <a href="/compare/final-round-ai/">Compare Final Round AI</a>
        <a href="/contact/">Contact</a>
        <a href={githubUrl}>GitHub</a>
        <a href={feedbackHref}>Send Feedback</a>
      </div>
    </div>
    <BacklinksFooter />
  </footer>
</MarketingLayout>
