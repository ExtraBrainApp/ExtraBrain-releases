---
import { getCollection } from 'astro:content';
import BlogListingPage from '../../components/BlogListingPage.astro';

const pageSize = 10;
const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const posts = allPosts.slice(0, pageSize);
const totalPages = Math.ceil(allPosts.length / pageSize);
---

<BlogListingPage posts={posts} currentPage={1} totalPages={totalPages} />
