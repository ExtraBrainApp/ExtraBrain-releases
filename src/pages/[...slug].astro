---
import { getCollection, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { marketingPages, pageBySlug } from '../data/product';

export async function getStaticPaths() {
  return marketingPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const page = Astro.props.page ?? pageBySlug(Astro.params.slug ?? '');

if (!page) {
  return Astro.redirect('/404.html');
}

const guides = await getCollection('marketingPageGuides');
const guide = guides.find((entry) => entry.id === page.slug);
const guideContent = guide ? (await render(guide)).Content : undefined;
---

<PageLayout page={page} guideContent={guideContent} />
