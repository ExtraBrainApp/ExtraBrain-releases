---
import { getCollection } from 'astro:content';
import BlogListingPage from '../../../components/BlogListingPage.astro';
import { interviewQuestionPageSize as pageSize, sortInterviewQuestionPosts } from '../../../data/interviewQuestions';

export async function getStaticPaths() {
  const allPosts = sortInterviewQuestionPosts(await getCollection('interviewQuestions', ({ data }) => !data.draft));
  const totalPages = Math.ceil(allPosts.length / pageSize);

  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
    const currentPage = index + 2;
    const start = (currentPage - 1) * pageSize;
    return {
      params: { page: String(currentPage) },
      props: {
        posts: allPosts.slice(start, start + pageSize),
        currentPage,
        totalPages,
      },
    };
  });
}

const { posts, currentPage, totalPages } = Astro.props;
---

<BlogListingPage
  posts={posts}
  currentPage={currentPage}
  totalPages={totalPages}
  basePath="/interview-questions/"
  baseTitle="ExtraBrain Interview Questions"
  titleSuffix="Company and Technical Interview Prep"
  description="Browse ExtraBrain interview question guides for coding interviews, system design, behavioral rounds, online assessments, and company-specific preparation."
  eyebrow="Interview Questions"
  breadcrumbLabel="Interview Questions"
  heading="Interview questions, coding prompts, and company prep guides."
  lead="Practical guides for preparing for technical, behavioral, system design, and company-specific interviews with responsible AI support."
  topics={['Company interview guides', 'Coding and assessment prep', 'System design and behavioral questions']}
  schemaType="CollectionPage"
  itemSchemaType="Article"
  readLabel="Read guide"
  paginationLabel="Interview question pages"
/>
