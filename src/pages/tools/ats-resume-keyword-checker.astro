---
import ToolLayout from '../../layouts/ToolLayout.astro';

const title = 'ATS Resume Keyword Checker - ExtraBrain';
const description = 'Free ATS resume keyword checker. Paste a job description and your resume to see which important keywords you match and which are missing. Runs in your browser.';
const faq = [
  { question: 'How does the ATS keyword checker work?', answer: 'It pulls the most frequent meaningful terms from the job description, then checks whether each appears in your resume, and shows a match score with the matched and missing keywords.' },
  { question: 'Will matching keywords guarantee I pass the ATS?', answer: 'No. Keyword alignment helps a resume surface in recruiter searches, but relevance, clear formatting, and genuine experience matter most. Only add keywords that are truthful for you.' },
  { question: 'Is my resume uploaded anywhere?', answer: 'No. The checker runs entirely in your browser. Your resume and the job description are never uploaded or stored.' },
];
---

<ToolLayout
  title={title}
  description={description}
  h1="ATS resume keyword checker."
  lead="Paste a job description and your resume to see which key terms you already match and which are missing, plus a simple match score. Use it to tune a resume before you apply. Everything runs in your browser."
  eyebrow="Free tool"
  faq={faq}
>
  <div class="tool-card">
    <div class="tool-grid cols-2">
      <div class="tool-field">
        <label for="jd">Job description</label>
        <textarea id="jd" placeholder="Paste the full job description here..."></textarea>
      </div>
      <div class="tool-field">
        <label for="resume">Your resume</label>
        <textarea id="resume" placeholder="Paste your resume text here..."></textarea>
      </div>
    </div>
    <div class="tool-actions">
      <button class="btn primary" id="check" type="button">Check keywords</button>
    </div>

    <div class="tool-result" id="result" hidden aria-live="polite">
      <h3>Match score</h3>
      <div class="tool-metric" id="score">-</div>
      <p class="tool-note" id="score-note"></p>
      <h3 style="margin-top:18px">Matched keywords</h3>
      <div class="tool-pill-row" id="matched"></div>
      <h3 style="margin-top:16px">Missing keywords</h3>
      <div class="tool-pill-row" id="missing"></div>
    </div>
  </div>
</ToolLayout>

<script is:inline>
  (function () {
    var jdEl = document.getElementById('jd');
    var resumeEl = document.getElementById('resume');
    var btn = document.getElementById('check');
    var result = document.getElementById('result');
    var scoreEl = document.getElementById('score');
    var scoreNote = document.getElementById('score-note');
    var matchedEl = document.getElementById('matched');
    var missingEl = document.getElementById('missing');
    if (!jdEl || !resumeEl || !btn) return;

    var stop = ('a an the and or but if then else of to in on for with without within as at by from into over under about across after before between during ' +
      'is are was were be been being am do does did done have has had having will would shall should can could may might must not no yes you your we our us they them their ' +
      'this that these those it its his her him she he i me my mine ours yours theirs who whom which what when where why how all any both each few more most other some such ' +
      'than too very just also up down out off again once here there only own same so up work working experience team teams role roles ability strong excellent good great ' +
      'you will years year plus etc including include includes required requirements preferred responsibilities responsible skills skill using use used help ideal candidate ' +
      'looking join company build building across new well like ensure drive deliver support world class per our the a ' +
      'hiring hire know knows knowledge must need needs want wants seeking seek role roles plus nice bonus strong proven demonstrated proficiency proficient familiar familiarity ' +
      'ability able understanding experience experienced background responsibilities day days week weeks month months etc').split(/\s+/);
    var stopSet = {};
    stop.forEach(function (w) { stopSet[w] = true; });

    function tokens(text) {
      return (text.toLowerCase().match(/[a-z0-9][a-z0-9+#.]*[a-z0-9+#]|[a-z0-9]/g) || []);
    }

    function keywords(jd) {
      var counts = {};
      tokens(jd).forEach(function (w) {
        if (w.length < 3 && w !== 'go' && w !== 'ai' && w !== 'ml' && w !== 'qa') return;
        if (stopSet[w]) return;
        counts[w] = (counts[w] || 0) + 1;
      });
      return Object.keys(counts).sort(function (a, b) {
        return counts[b] - counts[a] || a.localeCompare(b);
      }).slice(0, 30);
    }

    function run() {
      var jd = jdEl.value.trim();
      var resume = resumeEl.value.trim();
      if (!jd) { result.hidden = false; scoreEl.textContent = '-'; scoreNote.textContent = 'Paste a job description to analyze.'; matchedEl.innerHTML = ''; missingEl.innerHTML = ''; return; }
      var resumeTokens = {};
      tokens(resume).forEach(function (w) { resumeTokens[w] = true; });
      var kws = keywords(jd);
      var matched = [], missing = [];
      kws.forEach(function (k) { (resumeTokens[k] ? matched : missing).push(k); });
      var score = kws.length ? Math.round((matched.length / kws.length) * 100) : 0;
      result.hidden = false;
      scoreEl.textContent = score + '%';
      scoreNote.textContent = matched.length + ' of ' + kws.length + ' top job-description keywords found in your resume. Add missing terms only where they are truthful for your experience.';
      matchedEl.innerHTML = matched.length ? matched.map(function (k) { return '<span class="tool-pill match">' + k + '</span>'; }).join('') : '<span class="tool-note">None yet.</span>';
      missingEl.innerHTML = missing.length ? missing.map(function (k) { return '<span class="tool-pill missing">' + k + '</span>'; }).join('') : '<span class="tool-note">None. Great coverage.</span>';
    }

    btn.addEventListener('click', run);
  })();
</script>
