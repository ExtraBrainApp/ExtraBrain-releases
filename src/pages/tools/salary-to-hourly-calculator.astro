---
import ToolLayout from '../../layouts/ToolLayout.astro';

const title = 'Salary to Hourly Calculator - ExtraBrain';
const description = 'Free salary to hourly calculator. Convert any salary to hourly, monthly, weekly, and daily pay, or convert hourly back to annual, right in your browser.';
const faq = [
  { question: 'How do you convert salary to hourly pay?', answer: 'Divide annual salary by the number of hours worked per year. With a 40-hour week over 52 weeks, that is 2,080 hours, so a $104,000 salary is about $50 per hour.' },
  { question: 'How many work hours are in a year?', answer: 'A standard full-time schedule of 40 hours per week over 52 weeks is 2,080 hours per year. Adjust the hours-per-week field if your schedule differs.' },
  { question: 'Does this calculator send my data anywhere?', answer: 'No. The salary to hourly calculator runs entirely in your browser. Nothing you type is uploaded or stored.' },
];
---

<ToolLayout
  title={title}
  description={description}
  h1="Salary to hourly calculator."
  lead="Convert any pay rate into yearly, monthly, weekly, daily, and hourly figures. Useful when you are comparing an offer, negotiating, or checking a contract rate. Everything runs in your browser."
  eyebrow="Free calculator"
  faq={faq}
>
  <div class="tool-card">
    <div class="tool-grid cols-2">
      <div class="tool-field">
        <label for="amount">Amount</label>
        <input id="amount" type="number" inputmode="decimal" min="0" step="any" value="100000" />
      </div>
      <div class="tool-field">
        <label for="period">Pay period</label>
        <select id="period">
          <option value="year" selected>Per year</option>
          <option value="month">Per month</option>
          <option value="week">Per week</option>
          <option value="day">Per day</option>
          <option value="hour">Per hour</option>
        </select>
      </div>
      <div class="tool-field">
        <label for="hpw">Hours per week</label>
        <input id="hpw" type="number" inputmode="decimal" min="1" max="168" step="any" value="40" />
      </div>
      <div class="tool-field">
        <label for="wpy">Weeks per year</label>
        <input id="wpy" type="number" inputmode="decimal" min="1" max="52" step="any" value="52" />
      </div>
    </div>

    <div class="tool-result" id="result" aria-live="polite">
      <h3>Equivalent pay</h3>
      <div class="tool-grid cols-2" id="breakdown"></div>
      <p class="tool-note">Estimates use gross pay before taxes and deductions. Adjust hours and weeks to match your schedule.</p>
    </div>
  </div>
</ToolLayout>

<script is:inline>
  (function () {
    var amountEl = document.getElementById('amount');
    var periodEl = document.getElementById('period');
    var hpwEl = document.getElementById('hpw');
    var wpyEl = document.getElementById('wpy');
    var breakdown = document.getElementById('breakdown');
    if (!amountEl || !periodEl || !hpwEl || !wpyEl || !breakdown) return;

    var fmt = function (n) {
      if (!isFinite(n)) return '-';
      return n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: n < 100 ? 2 : 0 });
    };

    function compute() {
      var amount = parseFloat(amountEl.value) || 0;
      var hpw = parseFloat(hpwEl.value) || 0;
      var wpy = parseFloat(wpyEl.value) || 0;
      var hoursPerYear = hpw * wpy;
      var annual;
      switch (periodEl.value) {
        case 'hour': annual = amount * hoursPerYear; break;
        case 'day': annual = amount * (hpw / 5) * wpy; break;
        case 'week': annual = amount * wpy; break;
        case 'month': annual = amount * 12; break;
        default: annual = amount;
      }
      var rows = [
        ['Per year', annual],
        ['Per month', annual / 12],
        ['Per week', wpy ? annual / wpy : NaN],
        ['Per day', wpy ? annual / (wpy * 5) : NaN],
        ['Per hour', hoursPerYear ? annual / hoursPerYear : NaN],
      ];
      breakdown.innerHTML = rows.map(function (r) {
        return '<div><h3>' + r[0] + '</h3><div class="tool-metric">' + fmt(r[1]) + '</div></div>';
      }).join('');
    }

    [amountEl, periodEl, hpwEl, wpyEl].forEach(function (el) {
      el.addEventListener('input', compute);
      el.addEventListener('change', compute);
    });
    compute();
  })();
</script>
