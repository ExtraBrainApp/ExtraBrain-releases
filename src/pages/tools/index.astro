---
import ToolLayout from '../../layouts/ToolLayout.astro';

const title = 'Free Interview and Career Tools - ExtraBrain';
const description = 'Free interview and career tools from ExtraBrain: salary to hourly calculator, job offer comparison, ATS resume keyword checker, STAR answer builder, and flashcards.';

const tools = [
  { title: 'Salary to hourly calculator', href: '/tools/salary-to-hourly-calculator/', desc: 'Convert any salary into yearly, monthly, weekly, daily, and hourly pay.' },
  { title: 'Job offer comparison calculator', href: '/tools/offer-comparison-calculator/', desc: 'Compare two offers by total yearly compensation, not just base salary.' },
  { title: 'ATS resume keyword checker', href: '/tools/ats-resume-keyword-checker/', desc: 'See which job-description keywords your resume matches and which are missing.' },
  { title: 'STAR answer builder', href: '/tools/star-answer-builder/', desc: 'Turn four notes into a structured behavioral interview answer with a word count.' },
  { title: 'Interview flashcards', href: '/tools/interview-flashcards/', desc: 'Rehearse common behavioral and technical questions with flip cards.' },
];

const faq = [
  { question: 'Are these interview tools free?', answer: 'Yes. Every tool here is free to use with no signup, and each one runs entirely in your browser.' },
  { question: 'Do the tools store my data?', answer: 'No. The calculators and checkers process everything locally in your browser. Nothing you type is uploaded or saved.' },
];
---

<ToolLayout
  title={title}
  description={description}
  h1="Free interview and career tools."
  lead="A growing set of free, browser-based tools to help you prepare, apply, and negotiate. No signup, nothing uploaded. Built by the team behind the ExtraBrain interview and meeting copilot."
  eyebrow="Free tools"
  faq={faq}
>
  <div class="tool-grid cols-2">
    {tools.map((t) => (
      <a class="tool-card tool-link" href={t.href}>
        <h2>{t.title}</h2>
        <p>{t.desc}</p>
        <span class="tool-link-cta">Open tool -&gt;</span>
      </a>
    ))}
  </div>
</ToolLayout>

<style is:global>
  .tool-link { display: flex; flex-direction: column; gap: 8px; text-decoration: none; transition: transform .18s var(--ease-standard), box-shadow .18s var(--ease-standard); }
  .tool-link:hover { transform: translateY(-2px); box-shadow: var(--shadow-editorial-glow); }
  .tool-link h2 { margin: 0; font-family: var(--font-serif); font-weight: 400; font-size: clamp(20px, 2.4vw, 26px); color: var(--ink); }
  .tool-link p { margin: 0; color: var(--text-secondary); }
  .tool-link-cta { margin-top: 6px; font-weight: 600; color: var(--editorial-purple-deep); font-size: 14px; }
</style>
