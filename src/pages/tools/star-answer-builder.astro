---
import ToolLayout from '../../layouts/ToolLayout.astro';

const title = 'STAR Method Answer Builder - ExtraBrain';
const description = 'Free STAR method answer builder. Turn a Situation, Task, Action, and Result into a structured behavioral interview answer, with word count and a copy button.';
const faq = [
  { question: 'What is the STAR method?', answer: 'STAR is a structure for behavioral interview answers: Situation, Task, Action, and Result. It keeps stories specific and easy to follow. See our glossary entry on the STAR method for more.' },
  { question: 'How long should a STAR answer be?', answer: 'Aim for roughly 150 to 250 words, about one to two minutes spoken. Spend most of the words on your Action and a clear, measurable Result.' },
  { question: 'Does this tool store what I write?', answer: 'No. The STAR builder runs entirely in your browser. Nothing you type is uploaded or saved.' },
];
---

<ToolLayout
  title={title}
  description={description}
  h1="STAR method answer builder."
  lead="Turn four short notes into a structured behavioral interview answer. Fill in the Situation, Task, Action, and Result, and get a clean draft with a word count you can rehearse from. Everything runs in your browser."
  eyebrow="Free tool"
  faq={faq}
>
  <div class="tool-card">
    <div class="tool-grid cols-2">
      <div class="tool-field"><label for="s">Situation - set the scene</label><textarea id="s" placeholder="What was the context? Keep it to a sentence or two."></textarea></div>
      <div class="tool-field"><label for="t">Task - your responsibility</label><textarea id="t" placeholder="What problem did you own? What did success look like?"></textarea></div>
      <div class="tool-field"><label for="a">Action - what you did</label><textarea id="a" placeholder="The steps you personally took and why. Use 'I', not 'we'."></textarea></div>
      <div class="tool-field"><label for="r">Result - the outcome</label><textarea id="r" placeholder="Measurable impact and what you learned. Add numbers if you can."></textarea></div>
    </div>
    <div class="tool-actions">
      <button class="btn primary" id="build" type="button">Build my answer</button>
      <button class="btn ghost" id="copy" type="button" hidden>Copy answer</button>
    </div>

    <div class="tool-result" id="result" hidden aria-live="polite">
      <h3>Your STAR answer <span id="wordcount" class="tool-note"></span></h3>
      <p id="answer" style="color:var(--ink);white-space:pre-wrap;line-height:1.6"></p>
    </div>
  </div>
</ToolLayout>

<script is:inline>
  (function () {
    var get = function (id) { return document.getElementById(id); };
    var build = get('build'), copy = get('copy'), result = get('result'), answer = get('answer'), wc = get('wordcount');
    if (!build) return;

    function assemble() {
      var s = get('s').value.trim();
      var t = get('t').value.trim();
      var a = get('a').value.trim();
      var r = get('r').value.trim();
      var parts = [];
      if (s) parts.push(s);
      if (t) parts.push(t);
      if (a) parts.push(a);
      if (r) parts.push(r);
      return parts.join('\n\n');
    }

    build.addEventListener('click', function () {
      var text = assemble();
      if (!text) { result.hidden = false; answer.textContent = 'Fill in at least one field to build your answer.'; wc.textContent = ''; copy.hidden = true; return; }
      answer.textContent = text;
      var words = text.split(/\s+/).filter(Boolean).length;
      var mins = Math.max(1, Math.round(words / 130));
      var guide = words < 120 ? ' - a little short; add detail to your Action and Result.' : (words > 280 ? ' - a bit long; tighten the Situation and Task.' : ' - a good length.');
      wc.textContent = '(' + words + ' words, about ' + mins + ' min spoken' + guide + ')';
      result.hidden = false;
      copy.hidden = false;
    });

    copy.addEventListener('click', function () {
      var text = answer.textContent || '';
      if (navigator.clipboard && text) {
        navigator.clipboard.writeText(text).then(function () {
          var label = copy.textContent; copy.textContent = 'Copied'; setTimeout(function () { copy.textContent = label; }, 1500);
        });
      }
    });
  })();
</script>
